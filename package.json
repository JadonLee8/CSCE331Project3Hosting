{
  "name": "project3-squad44",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "npm install --prefix frontend && cd backend && go mod download",
    "frontend": "npm run dev --prefix frontend",
    "backend": "cd backend && go tool air",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "cd backend && go build -o dist/ ./cmd/",
    "build": "npm run build:frontend && npm run build:backend",
    "clean": "node -e \"for (const d of ['dist','frontend/dist','backend/dist']) require('fs').rmSync(d, {recursive:true, force:true})\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
